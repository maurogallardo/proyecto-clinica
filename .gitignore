# Archivos que Git ignora (no se suben al repo, que es público)

# Datos locales de la herramienta de Supabase (versión y proyecto conectado)
supabase/.temp/

# Archivos donde se suelen guardar claves: nunca al repo
.env
.env.*

# La carpeta de pruebas (audios, dictados, capturas, copias de la app): nunca al repo
proyecto-clinica-pruebas/

# Paquetes de Node (se instalan, no se suben)
node_modules/
